        <div class="mt-4 text-white/60 text-sm space-y-1">
            <p>St 310 no 95 - Phnom Penh, Cambodia</p>
            <p>Ph: +855 69 595 947</p>
        </div>
        <div class="mt-6 flex justify-center space-x-6 text-white/40">
            <a href="#" class="hover:text-primary transition-colors"><i class="fab fa-instagram"></i></a>
            <a href="#" class="hover:text-primary transition-colors"><i class="fab fa-facebook"></i></a>
        </div>
        <p class="mt-8 text-[10px] tracking-[0.3em] uppercase text-white/30">© 2024 Ethereal Glow Wellness Sanctuary</p>
    </footer>

    <script>
        const form = document.getElementById('bookingForm');
        const submitBtn = document.getElementById('submitBtn');
        const statusDiv = document.getElementById('formStatus');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // UI state
            submitBtn.disabled = true;
            document.getElementById('btnText').textContent = "Processing...";
            
            const formData = new FormData(form);
            const object = Object.fromEntries(formData);
            const json = JSON.stringify(object);

            // 1. Submit to Web3Forms for Email notification
            fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: json
            })
            .then(async (response) => {
                let jsonResponse = await response.json();
                if (response.status == 200) {
                    // Success UI
                    statusDiv.innerHTML = "Success! Opening WhatsApp for confirmation...";
                    statusDiv.className = "p-4 rounded-lg text-sm mb-4 bg-green-100 text-green-700";
                    statusDiv.classList.remove('hidden');

                    // 2. Trigger WhatsApp Redirect with your NEW phone number
                    const wpNumber = "85569595947"; 
                    const wpMessage = `✨ *ETHEREAL GLOW BOOKING* ✨%0A%0A` +
                                     `👤 *Name:* ${encodeURIComponent(object.name)}%0A` +
                                     `📞 *Phone:* ${encodeURIComponent(object.phone)}%0A` +
                                     `📧 *Email:* ${encodeURIComponent(object.email)}%0A` +
                                     `🧖‍♀️ *Service:* ${encodeURIComponent(object.service)}%0A` +
                                     `👩‍⚕️ *Therapist:* ${encodeURIComponent(object.therapist)}%0A` +
                                     `📅 *Date:* ${encodeURIComponent(object.date)}%0A` +
                                     `⏰ *Time:* ${encodeURIComponent(object.time)}%0A%0A` +
                                     `_Submission confirmed via email system._`;

                    window.open(`https://wa.me/${wpNumber}?text=${wpMessage}`, '_blank');
                    form.reset();
                } else {
                    console.log(response);
                    statusDiv.innerHTML = "Something went wrong. Please try again.";
                    statusDiv.className = "p-4 rounded-lg text-sm mb-4 bg-red-100 text-red-700";
                    statusDiv.classList.remove('hidden');
                }
            })
            .catch(error => {
                console.log(error);
                statusDiv.innerHTML = "Network error. Check connection.";
                statusDiv.classList.remove('hidden');
            })
            .then(() => {
                submitBtn.disabled = false;
                document.getElementById('btnText').textContent = "Confirm & Message WhatsApp";
            });
        });
    </script>
