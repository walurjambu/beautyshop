                                <option value="Sarah (Lead Esthetician)">Sarah (Esthetician)</option>
                                <option value="Elena (Massages)">Elena (Massage Specialist)</option>
                                <option value="Marcus (Lashes)">Marcus (Lash Artist)</option>
                            </select>
                        </div>
                    </div>

                    <div class="space-y-1">
                        <label class="text-[10px] uppercase font-bold tracking-[0.2em] text-primary">Selected Treatment</label>
                        <select name="service" id="service" required class="w-full border-b border-gray-200 py-3 focus:outline-none focus:border-primary transition-colors bg-transparent">
                            <option value="">Select Service</option>
                            <option value="Oxygen Glow Facial ($120)">Oxygen Glow Facial ($120)</option>
                            <option value="Botanical Peel ($145)">Botanical Peel ($145)</option>
                            <option value="Hot Stone Serenity ($160)">Hot Stone Serenity ($160)</option>
                            <option value="Lash Artistry ($110)">Lash Artistry ($110)</option>
                            <option value="Brow Sculpt ($45)">Brow Sculpt ($45)</option>
