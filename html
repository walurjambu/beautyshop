                    <div id="formStatus" class="hidden p-4 rounded-lg text-sm mb-4"></div>

                    <button type="submit" id="submitBtn" class="w-full bg-primary text-white py-4 rounded-2xl font-bold uppercase tracking-widest hover:bg-accent transition-all shadow-xl flex items-center justify-center gap-3">
