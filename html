    <section id="booking" class="py-24 bg-softPink px-4 overflow-hidden">
        <div class="max-w-5xl mx-auto bg-white rounded-[3rem] shadow-2xl overflow-hidden flex flex-col lg:flex-row">
            <div class="lg:w-1/3 bg-accent p-12 text-white flex flex-col justify-between">
                <div>
                    <h2 class="font-serif text-4xl mb-4 italic">Reserve Your Time</h2>
                    <p class="text-white/70 text-sm leading-relaxed mb-8">
                        Once you submit this form, we will receive your email request and you will be redirected to WhatsApp for instant confirmation.
                    </p>
                    <div class="space-y-4 text-sm">
                        <p><i class="fas fa-clock mr-3 text-primary"></i> Mon-Sat: 10am - 8pm</p>
                        <p><i class="fas fa-map-marker-alt mr-3 text-primary"></i> St 310 no 95 - Phnom Penh, Cambodia</p>
                        <p><i class="fas fa-phone-alt mr-3 text-primary"></i> +855 69 595 947</p>
                    </div>
                </div>
            </div>

            <div class="lg:w-2/3 p-12">
                <!-- FORM SUBMITTING TO WEB3FORMS -->
                <form id="bookingForm" action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
                    <!-- Web3Forms API Key -->
                    <input type="hidden" name="access_key" value="c2d79451-673a-494b-90a0-cbf0e3e99fec">
                    <input type="hidden" name="subject" value="New Appointment Request - Ethereal Glow">
                    <input type="hidden" name="from_name" value="Ethereal Glow Website">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase font-bold tracking-[0.2em] text-primary">Full Name</label>
                            <input type="text" name="name" id="name" required placeholder="Jane Doe" class="w-full border-b border-gray-200 py-3 focus:outline-none focus:border-primary transition-colors bg-transparent">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase font-bold tracking-[0.2em] text-primary">Phone Number</label>
                            <input type="tel" name="phone" id="phone" required placeholder="+1 (555) 000-0000" class="w-full border-b border-gray-200 py-3 focus:outline-none focus:border-primary transition-colors bg-transparent">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase font-bold tracking-[0.2em] text-primary">Email Address</label>
                            <input type="email" name="email" id="email" required placeholder="jane@example.com" class="w-full border-b border-gray-200 py-3 focus:outline-none focus:border-primary transition-colors bg-transparent">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[10px] uppercase font-bold tracking-[0.2em] text-primary">Therapist Preference</label>
                            <select name="therapist" id="therapist" class="w-full border-b border-gray-200 py-3 focus:outline-none focus:border-primary transition-colors bg-transparent">
